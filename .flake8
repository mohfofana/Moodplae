[flake8]
max-line-length = 120
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    .pytest_cache,
    .mypy_cache,
    .venv,
    venv,
    env,
    build,
    dist
per-file-ignores =
    # Allow unused imports in __init__.py
    __init__.py: F401
    # Allow star imports in tests
    tests/*.py: F403,F405
    # Allow redefining builtins in tests
    tests/*.py: A001,A002,A003
    # Allow long lines in strings
    *.py: E501
